#!/usr/bin/env bash
set -euo pipefail

source_root="${1:?usage: message-component-cannot-own-local-ledger <source-root>}"

for retired in \
  "$source_root/build.rs" \
  "$source_root/src/frame_bytes.rs" \
  "$source_root/src/surface.rs"
do
  if [[ -e "$retired" ]]; then
    echo "message still owns retired structural or compatibility source: $retired" >&2
    exit 1
  fi
done

if find "$source_root/schema" "$source_root/src/schema" -type f -print -quit 2>/dev/null | rg --quiet .
then
  echo "message still owns component-local structural source" >&2
  exit 1
fi

retired_text='no''ta'
retired_generator='schema''-rust'

if rg --line-number --ignore-case \
  --glob 'Cargo.toml' \
  --glob 'flake.nix' \
  --glob 'src/**' \
  --glob '!scripts/message-component-cannot-own-local-ledger' \
  "${retired_text}|${retired_generator}|GenerationDriver|GenerationPlan|ModuleEmission|ComponentDaemon|DaemonEntry" \
  "$source_root"
then
  echo "message restored retired text, generation, or daemon-shape ownership" >&2
  exit 1
fi
