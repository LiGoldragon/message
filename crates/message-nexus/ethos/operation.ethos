; Message's typed effects on Flow and its own Memory.
;
; Every refusal retains Flow's exact kind and payload. Message's own
; persistence failure is StoreRefused; Flow's failure is Store.String.

Operation
[ signal_flow:[ FlowId Address DeliverKey SendableMessage Process ]
  message_library:Configuration ]
[ Bind.{ Address                ; register the Message process
         Process }
  Identify.Process              ; name the caller's metaflow
  Lock.{ Address                ; the sender, to which Up is resolved,
         Address }              ; then the recipient
  Deliver.{ :signal_flow:Lock   ; hand Flow the message under a durable key
            DeliverKey
            SendableMessage }
  Acknowledge.Vector<DeliverKey> ; release Flow replay ownership after ledger write
  Release.:signal_flow:Lock     ; return the lock after failure
  Store.Configuration ]         ; write Memory
[ Bound.FlowId
  Identified.Address
  Locked.:signal_flow:Lock
  Delivered
  Acknowledged
  Woken.FlowId
  Queued
  Released
  Stored
  Failed.[ Unidentified.Process
           Taken.Address
           NotMessage
           NoneAbove
           Unknown.[ Address Lock.:signal_flow:Lock ]
           Ended.Address
           Asleep
           OffRoute
           Held.:signal_flow:Lock
           Locked
           NoLayer
           Lapsed
           FlowUnreachable
           StoreRefused
           Store.String ] ]
[]
