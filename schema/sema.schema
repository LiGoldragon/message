{
  RegistryCommand message:signal:AgentRegistryCommand
  RegistryQuery message:signal:AgentRegistryQuery
  RegistryReply message:signal:Output
}
[WriteInput ReadInput]
[WriteOutput ReadOutput]
{
  WriteInput [(ApplyRegistry RegistryCommand)]

  ReadInput [(ReadRegistry RegistryQuery)]

  WriteOutput [(RegistryApplied RegistryReply)]
  ReadOutput [(RegistryRead RegistryReply)]
}
