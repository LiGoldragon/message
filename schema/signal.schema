{}
[Submit SubmitStamped QueryInbox AssignAgentIdentity BindAgentEndpoint QueryAgentRegistry]
[SubmissionAccepted SubmissionRejected InboxListing AgentIdentityAssigned AgentEndpointBound AgentRegistryListing AgentRegistryRejected Unimplemented Error]
{
  Submit MessageSubmission
  SubmitStamped StampedMessageSubmission
  QueryInbox InboxQuery
  AssignAgentIdentity AgentIdentityAssignment
  BindAgentEndpoint AgentEndpointBinding
  QueryAgentRegistry AgentRegistryQuery

  SubmissionAccepted SubmissionAcceptance
  SubmissionRejected SubmissionRejection
  InboxListing InboxContents
  AgentIdentityAssigned AssignedAgentIdentity
  AgentEndpointBound BoundAgentEndpoint
  AgentRegistryListing AgentRegistryEntries
  AgentRegistryRejected AgentRegistryRejection
  Unimplemented RequestUnimplemented
  Error ErrorReport

  Recipient String
  Sender String
  Body String
  MessageSlot Integer
  OwnerName String
  TimestampNanos Integer
  ErrorMessage String

  MessageKind [Send Inbox]
  Kind MessageKind

  ThreadName String
  ThreadSelection [None (Named ThreadName)]

  MessageSubmission {
    Recipient
    Kind
    Body
    ThreadSelection
  }

  ConnectionClass [Owner NonOwnerUser InternalComponentInstance]
  MessageOrigin {
    ConnectionClass
    OwnerName
  }
  Submission MessageSubmission
  Origin MessageOrigin
  StampedAt TimestampNanos
  StampedMessageSubmission {
    Submission
    Origin
    StampedAt
  }

  InboxQuery Recipient
  InboxEntry {
    MessageSlot
    Sender
    Body
  }
  InboxEntries (Vector InboxEntry)
  InboxContents InboxEntries

  SubmissionAcceptance MessageSlot
  SubmissionRejectionReason [StoreRejected RecipientNotFound]
  SubmissionRejection SubmissionRejectionReason

  OperationKind [Submit SubmitStamped QueryInbox AssignAgentIdentity BindAgentEndpoint QueryAgentRegistry]
  UnimplementedReason [NotInPrototypeScope RouterUnreachable]

  AgentIdentifier String
  HarnessPid Integer
  HarnessStartTime Integer
  ResumeIdentity String
  ResumeSelection [None (Resumed ResumeIdentity)]

  AgentEndpointKind [PtySocket HarnessSocket]
  EndpointPath String
  AgentEndpoint {
    AgentEndpointKind
    EndpointPath
  }
  EndpointSelection [None (Bound AgentEndpoint)]
  AgentDeathMark [NotDead Killed]

  HarnessProcessPin {
    HarnessPid
    HarnessStartTime
  }
  ProcessPinSelection [None (Pinned HarnessProcessPin)]

  AgentIdentityAssignment {
    AgentIdentifier
    ProcessPinSelection
    ResumeSelection
  }
  IdentityProvenance [Seated Reseated]
  AssignedAgentIdentity {
    AgentIdentifier
    IdentityProvenance
  }

  AgentEndpointBinding {
    AgentIdentifier
    AgentEndpoint
    HarnessPid
    HarnessStartTime
  }
  BoundAgentEndpoint AgentIdentifier

  AgentRegistryQuery [All (ByAgent AgentIdentifier)]
  AgentRegistryEntry {
    AgentIdentifier
    EndpointSelection
    ResumeSelection
    AgentDeathMark
    ProcessPinSelection
  }
  AgentRegistryEntries (Vector AgentRegistryEntry)
  AgentRegistryRejectionReason [UnknownAgentIdentifier StoreRejected]
  AgentRegistryRejection AgentRegistryRejectionReason

  AgentRegistryCommand [(AssignIdentity AgentIdentityAssignment) (BindEndpoint AgentEndpointBinding)]
  UnimplementedOperationKind OperationKind
  Reason UnimplementedReason
  RequestUnimplemented {
    UnimplementedOperationKind
    Reason
  }

  ErrorReport ErrorMessage
}
